/****************************************************************
 ********* Slurm configuration for ILRI HPC clusters ************
 ***************************************************************/

profiles {
  singularity {
    singularity.enabled = true
    singularity.autoMounts = true
    singularity.pullTimeout = '1 h'
    singularity.cacheDir = "${baseDir}/singularity"
        process {
            beforeScript = """
                               module load nextflow/25.04
                           """
                           .stripIndent()
            executor = 'slurm'
            // clusterOptions = {"--nodelist=compute07"} // you may need to change this for the taxonomic_classification and assembly subworkflows
            // queue = 'highmem'
            clusterOptions = {
                switch (params.analysis_type) {
                    case 'taxonomy':  return '--nodelist=compute07'
                    case 'alignment': return '--nodelist=compute06'
                    case 'assembly':  return '--nodelist=compute05'
                    default:          return ''
                }
            }
            queue = {
                switch (params.analysis_type) {
                    case 'taxonomy':  return 'highmem'
                    case 'alignment': return 'batch'
                    case 'assembly':  return 'batch'
                    default:          return 'batch'
                }
            }
            scratch = true
            containerOptions = { "--bind /var/scratch --bind ${params.kraken2_db}:${params.kraken2_db}" }

            cpus   = { 1      * task.attempt }
            memory = { 6.GB   * task.attempt } 
            time   = { 4.h    * task.attempt }

            errorStrategy = { task.exitStatus in ((130..145) + 104 + 175 + 255) ? 'retry' : 'finish' }
            maxRetries = 2
            maxErrors = '-1'

            withLabel:process_single {
                cpus   = { 2                   }
                memory = { 6.GB * task.attempt }
                time   = { 4.h  * task.attempt }
            }
            withLabel:process_low {
                cpus   = { 4     * task.attempt }
                memory = { 16.GB * task.attempt }
                time   = { 4.h   * task.attempt }
            }
            withLabel:process_medium {
                cpus   = { 7     * task.attempt }
                memory = { 36.GB * task.attempt }
            }
            withLabel:process_high {
                cpus   = { 7    * task.attempt }
                memory = { 144.GB * task.attempt }
                time   = { 16.h  * task.attempt }
            }
            withLabel:process_long {
                queue = 'batch'
                cpus   = { 8    * task.attempt }
                time   = { 20.h  * task.attempt }
            }
            withLabel:error_ignore {
                errorStrategy = 'ignore'
            }
            withLabel:error_retry {
                errorStrategy = 'retry'
                maxRetries    = 2
            }
            withLabel: process_gpu {
                ext.use_gpu = { workflow.profile.contains('gpu') }
                accelerator = { workflow.profile.contains('gpu') ? 1 : null }
            }
        }
    }
    docker {
        docker.enabled         = true
        // not currently used by the run; if you use -profile docker, add a
        process { 
            containerOptions = { "-v ${params.kraken2_db}:${params.kraken2_db}" } 
            }
        // block here the same way, rather than setting docker.runOptions dynamically
        }
}